# === MongoDB ===
# Atlas 連線字串，或本機 mongodb://127.0.0.1:27017/jiuli-hai
NUXT_MONGODB_URI="mongodb://127.0.0.1:27017/jiuli-hai"

# === Session ===
# 用於簽發使用者 session 的密鑰，請改成一段長亂數
NUXT_SESSION_SECRET="please-change-this-to-a-long-random-string"

# === 站台網址 ===
# 後台產 QR 時用來組掃碼網址（`<網址>/?s=<token>`），民眾用手機內建相機掃就能開站集章。
# 留空則取後台當下的 origin；前後台分域部署時務必填前台網址
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# === LINE LIFF ===
# LINE Developers → LINE Login channel → LIFF 分頁建立的 LIFF app ID（格式 <channelId>-<hash>）。
# 後台的活動入口與各點 QR 會編成 https://liff.line.me/<這個ID>?c=... / ?s=...，
# 民眾點開會先過 LINE 登入，換瀏覽器、換裝置都還是同一個身分。
# ★★ 把你的 LIFF ID 貼在這裡 ★★
# 留空 = 不啟用 LINE 登入，維持匿名訪客身分（本機開發預設）
NUXT_PUBLIC_LIFF_ID=""

# 後端驗證 LINE ID token 用的 LINE Login channel ID。
# 留空 = 取 NUXT_PUBLIC_LIFF_ID 的前綴（LIFF ID 格式為 <channelId>-<hash>），一般不必填
NUXT_LINE_CHANNEL_ID=""

# === 圖片上傳（Vercel Blob）===
# 後台上傳的圖片要存去哪。有值 = 存到 Vercel Blob（線上必須，serverless 檔案系統唯讀）；
# 留空 = 寫本機 public/uploads/，本機開發不設也能上傳。
# 在 Vercel 後台建好 Blob store 後會自動加進線上環境變數，本機用 npx vercel env pull 取得
BLOB_READ_WRITE_TOKEN=""

# === 商家核銷 ===
# 現場核銷時工作人員在民眾手機上輸入的通行碼（獎項彈窗的「確認核銷」那一步）。
# 後台可逐檔活動設定 4 碼核銷碼；活動沒設才會用這組當預設
NUXT_STAFF_PASSCODE="change-this-staff-passcode"

# === 營運後台 ===
# 管理員在後台 /admin 輸入的通行碼
NUXT_ADMIN_PASSCODE="change-this-admin-passcode"

# === 網域分離部署（前後台分開網域時使用，選配） ===
# 後台網域白名單，逗號分隔（如 admin.example.com,admin-staging.example.com）。
# 本機測試可用「host:port」（如 localhost:3001）模擬第二個網域。
# 留空 = 不啟用檢查，/admin 維持現有可直接訪問行為（本機開發預設）
NUXT_ADMIN_HOSTNAMES=""

# === GPS 地理圍籬 ===
# 座標尚未實地校正前建議關閉，否則會誤擋
NUXT_GEOFENCE_ENFORCE="false"
NUXT_GEOFENCE_RADIUS_M="300"
# 前端用（要與上面 NUXT_GEOFENCE_ENFORCE 設成同一個值）。
# 關閉時掃碼不會向使用者要定位權限，少一個彈窗
NUXT_PUBLIC_GEOFENCE_ENFORCE="false"

# === Google Maps ===
# 前端 Maps JavaScript API key（需在 Google Cloud 啟用 Maps JavaScript API + billing）
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
