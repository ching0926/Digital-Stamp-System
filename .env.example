# === MongoDB ===
# Atlas 連線字串，例如 mongodb+srv://user:pass@cluster.xxx.mongodb.net/jiuli-hai
NUXT_MONGODB_URI="mongodb://127.0.0.1:27017/jiuli-hai"

# === Session ===
# 用於簽發使用者 session 的密鑰，請改成一段長亂數
NUXT_SESSION_SECRET="please-change-this-to-a-long-random-string"

# === LINE Login / LIFF ===
# LINE Login channel ID（後端驗證 idToken 用）
NUXT_LINE_CHANNEL_ID="your-line-login-channel-id"
# LIFF app ID（前端 liff.init 用，會暴露給瀏覽器）
NUXT_PUBLIC_LIFF_ID="your-liff-id"

# === 商家核銷 ===
# 工作人員在核銷頁輸入的通行碼
NUXT_STAFF_PASSCODE="change-this-staff-passcode"

# === GPS 地理圍籬 ===
NUXT_GEOFENCE_ENFORCE="true"
NUXT_GEOFENCE_RADIUS_M="300"
